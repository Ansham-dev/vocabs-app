# Copy this file to .env.local and fill in real values. Never commit .env.local.
# MongoDB Atlas connection string (get from Atlas -> Connect -> Drivers -> Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vocabs?retryWrites=true&w=majority

# Auth: random string, min 16 chars. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-min-16-chars

# AI chat (server-side only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
